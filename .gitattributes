# What a Composer consumer actually receives.
#
# `export-ignore` only affects the dist archive built from a tag. It keeps the
# package to what the package is: the CLI, the source and the readme. Nothing
# here changes what is in the repository.

* text=auto eol=lf

# Shell scripts that run on Citadel stay LF.
*.sh text eol=lf

# Windows developer scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# The Squire copy is a verbatim export (all LF). Keep its exact bytes so the
# `squire-copy:check` gate sees no drift from line-ending normalization.
/templates/squire/** -text

# Not part of the package.
/tests             export-ignore
/site              export-ignore
/BEST_PRACTICES.md export-ignore
/composer.lock     export-ignore
/phpunit.xml.dist  export-ignore
/.gitattributes    export-ignore
/.gitignore        export-ignore
/docs/readme          export-ignore
/scripts/readme-art   export-ignore
/bin/agent-ready.php export-ignore
