# syntax=docker/dockerfile:1.7
# Generated by Sourdough. Two targets: `dev` (used by compose.yaml) and `prod`.
#
# Base images are pinned by manifest-list digest, so one pin resolves natively on
# amd64 and arm64. These FROM lines are the single place to swap in SQUIRE's
# Citadel-parity image when it exists. Rebuild regularly with --pull.
#
# Playbook is a private package. Pass its credentials to the build as a BuildKit
# secret, never as a build arg and never baked into a layer:
#   docker build --target prod --secret id=composer_auth,src=auth.json .
# (auth.json is a Composer auth file; it is not copied into the image.)

FROM composer:2.10.3@sha256:2cf275428757e5435a667bfc0d038b14520ca02be2b1b70d44a05c8c19e2de48 AS composer-bin

FROM php:8.5-cli-trixie@sha256:9236fd373d3bcda0659cf94838a744bd79791419292958963f8c6b34a0071554 AS dev
# The dev container runs as root on purpose: it is local only, and Docker Desktop
# bind mounts show files as root-owned, so a non-root user cannot write .env,
# storage or bootstrap/cache.
ENV COMPOSER_ALLOW_SUPERUSER=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git unzip libicu-dev libzip-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql intl zip bcmath pcntl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer-bin /usr/bin/composer /usr/local/bin/composer
COPY --from=node:22.23.4-trixie /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22.23.4-trixie /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY docker/php.ini /usr/local/etc/php/conf.d/zz-app.ini
WORKDIR /app
EXPOSE 8000
CMD ["sh", "-c", "[ -f vendor/autoload.php ] || composer install --no-interaction; [ -f .env ] || cp .env.example .env; grep -q '^APP_KEY=base64:' .env || php artisan key:generate --force; php artisan migrate --force; exec php artisan serve --host=0.0.0.0 --port=8000"]

FROM php:8.5-apache-trixie@sha256:4cc63b3d4e05c40da73e7af5d39364ca2678ac07208919497bda3bbab975be95 AS prod
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git unzip libicu-dev libzip-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql intl zip bcmath \
    && a2enmod rewrite headers \
    && sed -ri 's!/var/www/html!/var/www/html/public!g' /etc/apache2/sites-available/000-default.conf \
    && sed -ri 's/Listen 80$/Listen 8080/' /etc/apache2/ports.conf \
    && sed -ri 's/<VirtualHost \*:80>/<VirtualHost *:8080>/' /etc/apache2/sites-available/000-default.conf \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer-bin /usr/bin/composer /usr/local/bin/composer
COPY docker/php.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/opcache.ini /usr/local/etc/php/conf.d/zz-opcache.ini
WORKDIR /var/www/html
COPY composer.json composer.lock ./
RUN --mount=type=secret,id=composer_auth,target=/root/.composer/auth.json,required=false \
    composer install --no-dev --no-interaction --no-scripts --prefer-dist --optimize-autoloader
COPY . .
RUN composer dump-autoload --no-dev --optimize \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache \
    && chgrp -R 0 storage bootstrap/cache \
    && chmod -R g=u storage bootstrap/cache
# Non-root and group-0 friendly, so the same image runs on Citadel-like hosts, OpenShift,
# Coolify and raw Docker. It listens on 8080 (no port below 1024 is needed).
USER www-data
EXPOSE 8080
