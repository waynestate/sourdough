# Pinstripe owns the level and the ignore hygiene: level 8, and every
# ignore needs a comment. It ships in require-dev, so the include below
# resolves for every app this template bakes. Point at
# vendor/waynestate/pinstripe/phpstan/strict.neon instead to take the
# strict cut.
includes:
    - vendor/waynestate/pinstripe/phpstan/raw.neon

parameters:
    paths:
        - src
        - public
