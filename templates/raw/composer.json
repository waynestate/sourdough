{
    "name": "wsu/{{app_slug}}",
    "description": "{{app_name}}",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "nyholm/psr7": "^1.8",
        "waynestate/helmet": "^1.3",
        "waynestate/sesame": "^0.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "waynestate/advisor": "^0.3",
        "waynestate/pinstripe": "^0.3",
        "waynestate/proctor": "^0.15"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "policy": {
            "cooldown": {
                "period": "3 days",
                "ignore": ["waynestate/*"]
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv APP_ENV=local",
            "@php -S localhost:8000 -t public"
        ],
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse",
        "proctor": "proctor check",
        "ci": [
            "@test",
            "@lint",
            "@analyse",
            "@proctor",
            "composer audit"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "serve": "Start the local dev server on http://localhost:8000 with APP_ENV=local, so SESAME uses its fake driver.",
        "lint": "Check the code style with Pint (Pinstripe's per preset).",
        "fix": "Fix the code style with Pint (Pinstripe's per preset).",
        "analyse": "Analyse the code with PHPStan (Pinstripe's raw preset, level 8).",
        "proctor": "Run PROCTOR's stack checks against the app.",
        "ci": "Run the full local gate: tests, Pint, PHPStan, PROCTOR and composer audit."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
