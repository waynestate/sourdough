{
    "name": "wsu/{{app_slug}}",
    "description": "{{app_name}}",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "waynestate/helmet": "^0.2",
        "waynestate/sesame": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "waynestate/advisor": "^0.1",
        "waynestate/proctor": "^0.2"
    },
    "scripts": {
        "test": "phpunit",
        "proctor": "proctor check",
        "ci": [
            "@test",
            "@proctor",
            "composer audit"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "proctor": "Run PROCTOR's stack checks against the app.",
        "ci": "Run the full local gate: tests, PROCTOR and composer audit."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
