# Local development. Production sets APP_ENV=production.
APP_ENV=local

# SESAME session limits, in minutes. Unset keeps the SESAME defaults.
# SESAME_IDLE_MINUTES=
# SESAME_ABSOLUTE_MINUTES=

# Comma-separated list of proxy addresses to trust. On Citadel the value is
# 172.18.0.1; on other hosts, the address of the proxy in front of the app;
# leave it empty locally.
# HELMET_PROXIES=
