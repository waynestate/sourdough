# Local development. Production sets APP_ENV=production.
APP_ENV=local

# SESAME session limits, in minutes. Unset keeps the SESAME defaults.
# SESAME_SESSION_IDLE_MINUTES=
# SESAME_SESSION_ABSOLUTE_MINUTES=

# The CAS server URL, used by the cas driver in production.
# SESAME_CAS_URL=
# This app's public URL, the service URL the CAS server redirects back to.
# SESAME_SERVICE_URL=

# Comma-separated list of proxy addresses to trust. On Citadel the value is
# 172.18.0.1; on other hosts, the address of the proxy in front of the app;
# leave it empty locally.
# HELMET_PROXIES=

# PHP errors go to stderr unless LOG_FILE points at a file.
# LOG_FILE=

# The session store. More than one replica needs a shared store (for
# example redis and tcp://redis:6379); unset keeps PHP's default.
# SESSION_SAVE_HANDLER=
# SESSION_SAVE_PATH=

# Oracle: leave these empty if your app does not use Oracle; nothing
# connects until they are set. On Citadel, set them in the app's
# environment settings, never in a file in git. Set ORACLE_TNS, or the
# host, port and service name.
# ORACLE_USERNAME=
# ORACLE_PASSWORD=
# ORACLE_TNS=
# ORACLE_HOST=
# ORACLE_PORT=
# ORACLE_SERVICE_NAME=
