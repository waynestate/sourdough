{
    "require": {
        "waynestate/helmet": "^1.3",
        "waynestate/sesame": "^0.7",
        "yajra/laravel-oci8": "^13.14"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3.0",
            "ext-oci8": "3.4.1"
        },
        "policy": {
            "cooldown": {
                "period": "3 days"
            }
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "waynestate/advisor": "^0.3",
        "waynestate/creed": "^0.1.8",
        "waynestate/pinstripe": "^0.3",
        "waynestate/proctor": "^0.11"
    },
    "scripts": {
        "boost-update": "@php -r \"exit(is_dir('vendor/laravel/boost') && is_file('boost.json') && ! empty(json_decode(file_get_contents('boost.json'), true)['agents']) ? pclose(popen(escapeshellarg(PHP_BINARY) . ' artisan boost:update --ansi', 'w')) : 0);\"",
        "ci": [
            "@composer validate --strict",
            "pest",
            "pint --test",
            "phpstan analyse --memory-limit=1G",
            "@composer audit"
        ],
        "lint:gitlab": "pint --test --format=gitlab > pint-codequality.json",
        "post-update-cmd": [
            "@boost-update"
        ],
        "proctor": "proctor check",
        "test": "pest"
    },
    "scripts-descriptions": {
        "boost-update": "Refresh Laravel Boost's guidelines and skills (php artisan boost:update). Skipped when Boost is not set up here: no boost.json naming an agent yet, or a composer --no-dev install.",
        "lint:gitlab": "Write Pint's findings as GitLab Code Quality JSON to pint-codequality.json ([] when clean), for the merge request widget."
    }
}
