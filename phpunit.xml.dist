<?xml version="1.0" encoding="UTF-8"?>
<!--
    Deprecations are failures (BEST_PRACTICES 4.13): a PHP or PHPUnit
    deprecation fails the run, with the test that raised it named, so
    PHP 8.5 and PHPUnit 12 never arrive as a surprise. A deprecation one
    package raises because of another (indirect) is theirs to fix and not
    counted.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="false"
         cacheDirectory=".phpunit.cache"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnPhpunitDeprecations="true">
    <testsuites>
        <testsuite name="sourdough">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
