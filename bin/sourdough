#!/usr/bin/env php
<?php

use Symfony\Component\Console\Application;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Output\OutputInterface;
use Waynestate\Sourdough\Command\AdoptCommand;
use Waynestate\Sourdough\Command\CheckCommand;
use Waynestate\Sourdough\Command\FeedCommand;
use Waynestate\Sourdough\Command\ManifestCommand;
use Waynestate\Sourdough\Command\NewCommand;
use Waynestate\Sourdough\Update\InstallKind;
use Waynestate\Sourdough\Update\PackagistFetcher;
use Waynestate\Sourdough\Update\UpdateCache;
use Waynestate\Sourdough\Update\UpdateNotice;

$autoload = __DIR__ . '/../vendor/autoload.php';
if (!is_file($autoload)) {
    // A dependency install (composer global require) keeps the autoloader
    // three folders up, at the root of the global vendor dir.
    $autoload = __DIR__ . '/../../../autoload.php';
}
if (!is_file($autoload)) {
    fwrite(STDERR, "vendor/autoload.php not found. Run `composer install` first.\n");
    exit(2);
}

require $autoload;

$version = '0.6.0';

$application = new class ('Sourdough', $version) extends Application {
    public function doRun(InputInterface $input, OutputInterface $output): int
    {
        $name = $this->getCommandName($input);
        if (null !== $name && '' !== $name && !$this->has($name)) {
            $output->getErrorOutput()->writeln(sprintf('Command "%s" is not defined.', $name));
            return 2;
        }

        return parent::doRun($input, $output);
    }
};

$application->addCommand(new NewCommand());
$application->addCommand(new ManifestCommand());
$application->addCommand(new AdoptCommand());
$application->addCommand(new FeedCommand());
$application->addCommand(new CheckCommand());

// After any command finishes, one line on stderr when a newer stable
// release exists. The check never throws, never writes to stdout and
// never changes the exit code; the running version is the one handed to
// the Application constructor above. Symfony Console 7 ships no event
// dispatcher with the application (and none is installed), so the check
// runs right after run() returns instead of on a TERMINATE event: same
// moment, same line, same exit code.
$packageRoot = dirname(__DIR__);
$notice = new UpdateNotice(
    'sourdough',
    $packageRoot,
    InstallKind::detect($packageRoot, getenv() ?: []),
    new UpdateCache('sourdough'),
    new PackagistFetcher(),
    static fn (): int => time(),
);
/** @var list<string> $argv */
$argv = $GLOBALS['argv'] ?? [];
$application->setAutoExit(false);
$exit = $application->run();
$notice->run(getenv() ?: [], $argv, $version, STDERR);

exit($exit);
