# The coding standard comes from Pinstripe (waynestate/pinstripe): level 8,
# deprecation checks, and the report flags all live in its raw preset. This
# file adds only what is specific to Sourdough itself.
includes:
    - vendor/waynestate/pinstripe/phpstan/raw.neon

parameters:
    paths:
        - src
        - bin
        - tests
    # The Laravel skeleton fixture is reference material, not Sourdough code:
    # its framework classes are not installed here, so analysing it would only
    # report unknown classes.
    excludePaths:
        - tests/fixtures/*
    # Tests run on 8.3, 8.4 and 8.5; analyse against that range.
    phpVersion:
        min: 80300
        max: 80599
