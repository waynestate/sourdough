            "status": "supported",
            "notice": null,
            "plans": {
                "bench": {
                    "advisor": {
                        "steps": [
                            "Copy the raw template into {dir}",
                            "Replace {{app_name}} and {{app_slug}} in file names and contents",
                            "Wire ADVISOR into the app"
                        ],
                        "next_steps": [
                            "cd {dir}",
                            "composer install",
                            "php vendor/bin/advisor install --client=claude --write",
                            "composer serve"
                        ]
                    },
                    "no-advisor": {
                        "steps": [
