{
    "name": "waynestate/sourdough",
    "description": "A starter that makes a Wayne State app with the stack already wired in.",
    "homepage": "https://sourdough.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/sourdough"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "justinrainbow/json-schema": "^6.0",
        "openai-php/client": "^0.21",
        "symfony/console": "^7.4",
        "symfony/http-client": "^7.4"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "bin": [
        "bin/sourdough"
    ],
    "autoload": {
        "psr-4": {
            "Waynestate\\Sourdough\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Sourdough\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": [
            "@composer validate --strict",
            "@test",
            "@lint",
            "@analyse",
            "@composer audit"
        ],
        "test": "phpunit",
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "squire-copy:check": "php scripts/squire-copy-check.php"
    },
    "scripts-descriptions": {
        "ci": "The full CI gate: validate, tests, Pint, PHPStan, audit. Same command on GitLab and GitHub.",
        "squire-copy:check": "Check that templates/squire/ still matches a fresh export from the SQUIRE checkout (SQUIRE_PATH, default /squire). Skips with exit 0 when no checkout is mounted."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
