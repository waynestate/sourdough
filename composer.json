{
    "name": "waynestate/sourdough",
    "description": "A starter that makes a Wayne State app with the stack already wired in.",
    "homepage": "https://sourdough.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/sourdough"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "justinrainbow/json-schema": "^6.0",
        "openai-php/client": "^0.21",
        "symfony/console": "^7.4",
        "symfony/http-client": "^7.4"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "waynestate/pinstripe": "^0.1",
        "waynestate/squire": "^0.2.2"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "bin": [
        "bin/sourdough"
    ],
    "autoload": {
        "psr-4": {
            "Waynestate\\Sourdough\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Sourdough\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": [
            "@composer validate --strict",
            "@test",
            "@lint",
            "@analyse",
            "@squire-copy:check",
            "@composer audit"
        ],
        "test": "phpunit",
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "squire-copy:sync": "php bin/sync-squire",
        "squire-copy:check": "php bin/sync-squire --check"
    },
    "scripts-descriptions": {
        "ci": "The full CI gate: validate, tests, Pint, PHPStan, SQUIRE copy check, audit. Same command on GitLab and GitHub.",
        "squire-copy:sync": "Rewrite templates/squire/ from the installed SQUIRE package (vendor/waynestate/squire). Run it when SQUIRE moves on, then commit the result.",
        "squire-copy:check": "Check that templates/squire/ still matches a fresh export from the installed SQUIRE package (vendor/waynestate/squire). Exits 1 on drift; exits 2 when the package is not installed."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
